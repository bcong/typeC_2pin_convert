  ;; ─────────────────────────────────────────────────────────────────
  ;; Wires
  ;; ─────────────────────────────────────────────────────────────────

  ;; J1 VBUS (pin1) at (92.38, 86.35) → short wire up → +5V power symbol at (92.38, 83.81)
  (wire
    (pts (xy 92.38 86.35) (xy 92.38 83.81))
    (stroke (width 0) (type default))
    (uuid "aaaa0001-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; J1 GND (pin6) at (92.38, 73.65) → short wire down → GND power at (92.38, 70)
  (wire
    (pts (xy 92.38 73.65) (xy 92.38 70))
    (stroke (width 0) (type default))
    (uuid "aaaa0002-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; J1 CC1 (pin4) at (92.38, 78.73) → wire left → R1 pin1 at (75, 91.31)
  ;; Route: (92.38, 78.73) → (70, 78.73) → (70, 91.31) → (75, 91.31)
  (wire
    (pts (xy 92.38 78.73) (xy 70 78.73))
    (stroke (width 0) (type default))
    (uuid "aaaa0003-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )
  (wire
    (pts (xy 70 78.73) (xy 70 91.31))
    (stroke (width 0) (type default))
    (uuid "aaaa0004-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )
  (wire
    (pts (xy 70 91.31) (xy 75 91.31))
    (stroke (width 0) (type default))
    (uuid "aaaa0005-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; J1 CC2 (pin5) at (92.38, 76.19) → wire right → R2 pin1 at (125, 91.31)
  ;; Route: (92.38, 76.19) → (130, 76.19) → (130, 91.31) → (125, 91.31)
  (wire
    (pts (xy 92.38 76.19) (xy 130 76.19))
    (stroke (width 0) (type default))
    (uuid "aaaa0006-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )
  (wire
    (pts (xy 130 76.19) (xy 130 91.31))
    (stroke (width 0) (type default))
    (uuid "aaaa0007-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )
  (wire
    (pts (xy 130 91.31) (xy 125 91.31))
    (stroke (width 0) (type default))
    (uuid "aaaa0008-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; R1 pin2 (GND top) at (75, 83.69) → up to GND power at (75, 95) reversed
  ;; GND power pin is at (75, 95) pointing down (angle 270), connection at (75, 95)
  ;; R1 pin2 is at (75, 83.69) → wire up to... wait, we need to connect to the GND net
  ;; Simpler: wire from R1 pin2 (75, 83.69) down to GND symbol at (75, 95)
  (wire
    (pts (xy 75 83.69) (xy 75 95))
    (stroke (width 0) (type default))
    (uuid "aaaa0009-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; PWR_FLAG at (82.55, 95) → connect to GND bus at (82.55, 95)
  ;; Draw a short wire from PWR_FLAG pin to GND net line
  (wire
    (pts (xy 82.55 95) (xy 75 95))
    (stroke (width 0) (type default))
    (uuid "aaaa000a-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; R2 pin2 (GND top) at (125, 83.69) → wire down to GND power at (125, 95)
  (wire
    (pts (xy 125 83.69) (xy 125 95))
    (stroke (width 0) (type default))
    (uuid "aaaa000b-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; J2 pin1 (VBUS/VBAT) at (96.19, 136.27) → wire down to +5V power at (96.19, 139.5)
  ;; Wait, +5V power goes UP from (96.19, 139.5) with pin at (96.19, 139.5) angle 90
  ;; J2 pin1 is at (96.19, 136.27) → +5V is above (smaller Y)
  ;; +5V power symbol pin at (96.19, 139.5) is BELOW J2 pin1 (136.27)
  ;; Let me move the +5V for J2 to be above: at (96.19, 132)
  ;; Actually since Y increases down, 136.27 < 139.5, so 139.5 is BELOW 136.27
  ;; So J2 pin1 (136.27) is ABOVE J2 center, and we want VBUS to come from above
  ;; Let me just draw a wire from J2 pin1 to a +5V label above
  ;; J2 pin1 at (96.19, 136.27) → +5V symbol pin at (96.19, 139.5): wire going DOWN
  (wire
    (pts (xy 96.19 136.27) (xy 96.19 139.5))
    (stroke (width 0) (type default))
    (uuid "aaaa000c-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; J2 pin2 (GND) at (96.19, 133.73) → wire to GND power at (96.19, 130)
  ;; GND power pin at (96.19, 130) angle 270 → connection at (96.19, 130)
  ;; J2 pin2 at (96.19, 133.73) → wire UP to (96.19, 130)
  (wire
    (pts (xy 96.19 133.73) (xy 96.19 130))
    (stroke (width 0) (type default))
    (uuid "aaaa000d-aaaa-4aaa-8aaa-aaaaaaaaaaaa")
  )

  ;; Junction at GND bus between J1 GND wire and bottom of GND symbol
  (junction (at 92.38 70) (diameter 0) (color 0 0 0 0)
    (uuid "bbbb0001-bbbb-4bbb-8bbb-bbbbbbbbbbbb")
  )

  ;; ─────────────────────────────────────────────────────────────────
  ;; No-connect marks on D- and D+ pins
  ;; ─────────────────────────────────────────────────────────────────
  (no_connect (at 92.38 83.81) (uuid "cccc0001-cccc-4ccc-8ccc-cccccccccccc"))
  (no_connect (at 92.38 81.27) (uuid "cccc0002-cccc-4ccc-8ccc-cccccccccccc"))

  ;; ─────────────────────────────────────────────────────────────────
  ;; Sheet instances
  ;; ─────────────────────────────────────────────────────────────────
  (sheet_instances
    (path "/"
      (page "1")
    )
  )
)
